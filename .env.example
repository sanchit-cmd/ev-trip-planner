# ==============================================================================
# EV Trip Planner - Environment Configuration Template
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Required for natural language trip parsing & explanation)
# Get a free key at: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
# Alternative variable name recognized by Google GenAI:
# GOOGLE_API_KEY=

# Optional Gemini model settings (default: gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# 2. Open Charge Map API (Required for finding EV charging stations)
# Register for a free API key at: https://openchargemap.org/site/develop/api
# ------------------------------------------------------------------------------
OCM_API_KEY=
# Country code for OCM search (default: IN)
OCM_COUNTRY=IN

# ------------------------------------------------------------------------------
# 3. Application User Agent (Recommended for Nominatim geocoding & OSRM)
# OpenStreetMap / Nominatim terms request an identifying contact string
# e.g.: ev-trip-planner user@example.com
# ------------------------------------------------------------------------------
APP_USER_AGENT=ev-trip-planner

# ------------------------------------------------------------------------------
# 4. Routing & Geocoding Options
# ------------------------------------------------------------------------------
# OSRM routing server (default: public demo server)
OSRM_URL=https://router.project-osrm.org

# Geocoding country filter (ISO 3166-1 alpha-2 code, default: in)
GEOCODE_COUNTRY=in

# ------------------------------------------------------------------------------
# 5. Local Cache & LLM Budget Settings
# ------------------------------------------------------------------------------
# SQLite cache file path
EV_DB=.ev_planner.db

# Daily LLM token limit (default: 100000; set to 0 to disable limit)
DAILY_TOKEN_BUDGET=100000

# Set to 1 to force offline/no-LLM mode (uses structured CLI flags only)
# EV_NO_LLM=0
